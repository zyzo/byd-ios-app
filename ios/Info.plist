<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AppGroup</key>
	<string>group.$(APP_BUNDLE_ID)</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(APP_BUNDLE_ID).trips.refresh</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Locks, unlocks and opens your car directly over Bluetooth when you are nearby.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connects to your BYD Companion server on your local network.</string>
	<key>ServerToken</key>
	<string>$(SERVER_TOKEN)</string>
	<key>ServerURL</key>
	<string>$(SERVER_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>fetch</string>
	</array>
</dict>
</plist>
