{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byd-companion",
  "main": "src/index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "containers": [
    {
      "class_name": "BydServer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "BYD_SERVER", "class_name": "BydServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BydServer"] }],
  // Non-secret region settings (same as in .env). Credentials are set with `wrangler secret put`.
  // The account comes from `wrangler login` or CLOUDFLARE_ACCOUNT_ID.
  "vars": {
    "BYD_BASE_URL": "https://dilinkappoversea-eu.byd.auto",
    "BYD_COUNTRY_CODE": "NL",
    "BYD_LANGUAGE": "en",
    "BYD_TIME_ZONE": "Europe/Amsterdam"
  },
  "observability": { "enabled": true }
}
