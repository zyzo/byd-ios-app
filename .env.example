# Copy to .env and fill in. .env is gitignored: never commit it.

# Your BYD app login. The PIN is the remote-control PIN set in the BYD app.
BYD_USERNAME=you@example.com
BYD_PASSWORD=your-byd-password
BYD_CONTROL_PIN=123456

# Your region's BYD server. These defaults are Europe. Examples:
#   Europe:    https://dilinkappoversea-eu.byd.auto   NL  Europe/Amsterdam
#   Vietnam:   https://dilinkappoversea-vn.byd.auto   VN  Asia/Ho_Chi_Minh
# A wrong region usually fails login with code 3008.
BYD_BASE_URL=https://dilinkappoversea-eu.byd.auto
BYD_COUNTRY_CODE=NL
BYD_LANGUAGE=en
BYD_TIME_ZONE=Europe/Amsterdam

# Shared secret between the iOS app and server.py. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
APP_TOKEN=replace-with-a-long-random-string

# Optional, for provision_ble_key.py only. Derived from BYD_COUNTRY_CODE when unset
# (VN -> VNM, BN -> BRN, UK -> GB, otherwise unchanged).
# BYD_WATCH_COUNTRY_CODE=VNM
